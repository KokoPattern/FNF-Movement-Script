type HumanoidBits = { hum: Humanoid, root: BasePart, animator: Animator }
local function getHumanoidBits(char: Model?): HumanoidBits?
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
    if not hum or not root then return nil end
    local anm = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
    return { hum = hum, root = root, animator = anm }
end

local function loadAnim(animator: Animator, id: string, looped: boolean, priority: Enum.AnimationPriority?): AnimationTrack?
    local ok, track = pcall(function()
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://"..id
        local t = animator:LoadAnimation(anim)
        t.Looped = looped
        t.Priority = priority or Enum.AnimationPriority.Action
        return t
    end)
    if ok then return track end
    return nil
end

local function tweenRoot(root: BasePart, targetCFrame: CFrame, duration: number, style: Enum.EasingStyle?, direction: Enum.EasingDirection?): boolean
    local wasAnchored = root.Anchored
    root.Anchored = true
    local tw = TweenService:Create(root, TweenInfo.new(duration, style or Enum.EasingStyle.Sine, direction or Enum.EasingDirection.InOut), {
        CFrame = targetCFrame
    })
    tw:Play()
    tw.Completed:Wait()
    root.Anchored = wasAnchored
    return true
end

