local MathPrecompute = {}
for i = 1, 360 do
    MathPrecompute[i] = {
        Sine = math.sin(math.rad(i)),
        Cosine = math.cos(math.rad(i)),
        Tangent = math.tan(math.rad(i)),
        ArcSine = math.asin(math.clamp(math.sin(math.rad(i)), -1, 1)),
        ArcCosine = math.acos(math.clamp(math.cos(math.rad(i)), -1, 1)),
        SquareRoot = math.sqrt(i),
        Logarithm = math.log(i + 1)
    }
end

for i = 361, 720 do
    MathPrecompute[i] = {
        Sine = math.sin(math.rad(i)),
        Cosine = math.cos(math.rad(i)),
        Tangent = math.tan(math.rad(i))
    }
end

