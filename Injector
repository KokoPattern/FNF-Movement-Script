function getCustomAssetFromURL(url)
    if not url or url == "" then return "" end
    if not url:match("^http") then return "rbxassetid://" .. url:gsub("%D", "") end
    
    local fileName = "FNF_Asset_" .. tostring(math.random(100000, 999999)) .. (url:match("%.gif") and ".gif" or ".png")
    local success, data = pcall(function() return game:HttpGet(url) end)
    
    if success and data then
        if writefile and getcustomasset then
            writefile(fileName, data)
            return getcustomasset(fileName)
        end
    end
    return "" -- Fallback
end

