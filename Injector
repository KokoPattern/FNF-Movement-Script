local function uiCorner(p: Instance, r: UDim?): UICorner
    local c = Instance.new("UICorner"); c.CornerRadius = r or UDim.new(0,8); c.Parent = p
    return c
end

local function uiStroke(p: Instance, col: Color3, th: number?): UIStroke
    local s = Instance.new("UIStroke"); s.Color = col; s.Thickness = th or 1.5; s.Parent = p; return s
end

local function makeLabel(parent: Instance, text: string, pos: UDim2, size: UDim2, color: Color3?, xAlign: Enum.TextXAlignment?, ts: number?): TextLabel
    local l = Instance.new("TextLabel")
    l.Size = size; l.Position = pos; l.BackgroundTransparency = 1
    l.Text = text; l.TextColor3 = color or Color3.fromRGB(180,180,180)
