    if #playlist == 0 then return end
    playlistIndex = playlistIndex + 1
    if playlistIndex > #playlist then playlistIndex = 1 end
end

local function prevPlaylistTrack()
    if #playlist == 0 then return end
    playlistIndex = playlistIndex - 1
    if playlistIndex < 1 then playlistIndex = #playlist end
end

-- ============================================================
--  [NEW] DOUBLE TROUBLE SYNC SYSTEM LOGIC WITH PUSHBACK
-- ============================================================
local function stopDoubleTrouble()
    SYNC_STATE.Enabled = false
    if SYNC_STATE.Connection then
        SYNC_STATE.Connection:Disconnect()
        SYNC_STATE.Connection = nil
    end
    SYNC_STATE.TargetPlayer = nil
    notify("Double Trouble Sync Offline", "error")
end

local function startDoubleTrouble(playerName: string)
    stopDoubleTrouble()
    if playerName == "" then return end
    
    local lowerName = playerName:lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Name:lower():sub(1, #lowerName) == lowerName then
            SYNC_STATE.TargetPlayer = p
            break
        end
    end
    
    if not SYNC_STATE.TargetPlayer then
        notify("Player not found for Sync!", "warn")
        return
    end
    
    local function bindToTargetAnimator(targetChar: Model)
        local hum = targetChar:WaitForChild("Humanoid", 5) :: Humanoid?
        local targetAnimator = hum and hum:WaitForChild("Animator", 5) :: Animator?
        if not targetAnimator then return end
        
        SYNC_STATE.Enabled = true
        notify("Double Trouble Synced to: " .. SYNC_STATE.TargetPlayer.Name, "success")
        
        SYNC_STATE.Connection = targetAnimator.AnimationPlayed:Connect(function(track)
            if not SYNC_STATE.Enabled then return end
            
            local id = track.Animation.AnimationId:match("%d+")
            if not id then return end
            
            local randomDir = ARROW_ORDER[math.random(1, #ARROW_ORDER)]
            
            task.delay(SYNC_STATE.MimicDelay, function()
                playAnim("SYNC_MIMIC", id, 1, false)
                hitArrow(randomDir)
                task.delay(0.2, function() releaseArrow(randomDir) end)

                if SYNC_STATE.PushbackEnabled and character and targetChar then
                    local myRoot = character:FindFirstChild("HumanoidRootPart") :: BasePart?
                    local trRoot = targetChar:FindFirstChild("HumanoidRootPart") :: BasePart?
                    if myRoot and trRoot then
                        local awayVector = (myRoot.Position - trRoot.Position)
                        local distance = awayVector.Magnitude
                        if distance > 0.1 and distance < rpMaxDistance then
                            local actualStep = math.min(rpRetreatStep, rpMaxDistance - distance)
                            myRoot.CFrame = myRoot.CFrame + (awayVector.Unit * actualStep)
                        end
                    end
                end
            end)
        end)
    end
    
    if SYNC_STATE.TargetPlayer.Character then
        bindToTargetAnimator(SYNC_STATE.TargetPlayer.Character)
    end
    
    SYNC_STATE.TargetPlayer.CharacterAdded:Connect(function(char)
        if SYNC_STATE.Enabled then bindToTargetAnimator(char) end
    end)
end

