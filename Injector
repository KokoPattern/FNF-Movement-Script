local function SaveConfig()
    local data = {
        Bindings = CurrentBindings,
        Theme = currentThemeName,
        IdleBPM = idleBPM,
        BaseBPM = BASE_BPM,
        CustomDecals = CUSTOM_DECALS,
        BgDecal = BG_DECAL_ID,
        VinylDecal = VINYL_DECAL_ID,
        FaceIds = faceIds,
    }
    if writefile then
        pcall(function()
            writefile(CONFIG_FILE, HttpService:JSONEncode(data))
            log("Config Saved!")
        end)
    end
end

local function LoadConfig()
    if safe_isfile(CONFIG_FILE) and readfile then
        local ok, result = pcall(function()
            return HttpService:JSONDecode(readfile(CONFIG_FILE))
        end)
        if ok and result then
            if result.Bindings then CurrentBindings = result.Bindings end
            if result.Theme then currentThemeName = result.Theme end
            if result.IdleBPM then idleBPM = result.IdleBPM end
            if result.BaseBPM then BASE_BPM = result.BaseBPM end
            if result.CustomDecals then CUSTOM_DECALS = result.CustomDecals end
            if result.BgDecal then BG_DECAL_ID = result.BgDecal end
            if result.VinylDecal then VINYL_DECAL_ID = result.VinylDecal end
            if result.FaceIds then faceIds = result.FaceIds end
            log("Config Loaded successfully.")
        end
    end
end

-- ============================================================
