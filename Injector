function onNetworkMessage(message)
    local msgText = message.Text or message.Message
    local sourceUser = message.TextSource and message.TextSource.UserId or message.SenderId
    if not sourceUser or sourceUser == LocalPlayer.UserId then return end -- Ignore our own

    if msgText and msgText:match("^" .. NETWORK_PREFIX:gsub("%[", "%%["):gsub("%]", "%%]")) then
        local content = msgText:sub(#NETWORK_PREFIX + 2)
        local separator = content:find("|")
        if not separator then return end
        
        local action = content:sub(1, separator - 1)
        local data = content:sub(separator + 1)
        
        local peerPlayer = Players:GetPlayerByUserId(sourceUser)
        if not peerPlayer then return end

        if not scriptPeers[sourceUser] then
            scriptPeers[sourceUser] = { name = peerPlayer.DisplayName, anim = "" }
            notify(peerPlayer.Name .. " is using FNF Injector v8.0!", "info")
        end

        if action == "PING" then
            -- Initial handshake
            local peerCustomName = data
            scriptPeers[sourceUser].name = peerCustomName
            rebuildNametag(peerPlayer, peerCustomName)

        elseif action == "CHAT" then
            -- Dialogue message
            local chatSeparator = data:find("~")
            local animId = ""
            local msg = data
            if chatSeparator then
                animId = data:sub(1, chatSeparator - 1)
                msg = data:sub(chatSeparator + 1)
            end
            scriptPeers[sourceUser].anim = animId
            buildDialogueUI(peerPlayer.Character, scriptPeers[sourceUser].name, msg, animId)
        end
    end
end

if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
