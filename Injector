function SaveData()
    if writefile then
        local dataToSave = {
            Background = DataStoreConfig.CustomBackgroundId,
            BgTransparency = DataStoreConfig.CustomBackgroundTransparency,
            NametagName = DataStoreConfig.CustomNametagName,
            DialogueSound = DataStoreConfig.CustomDialogueSound
