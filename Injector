    local HealthDrainEnabled = false
    local IntenseModeEnabled = false
    local LastArrowHitTick = os.clock()
    local IntenseWarningFired = false
    
    local function BroadcastNoteHit()
        pcall(function()
            if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
                TextChatService.TextChannels.RBXGeneral:SendAsync("[FNF_ARROW_HIT]")
            else
                ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer("[FNF_ARROW_HIT]", "All")
            end
        end)
    end

    local function ProcessHealthDrain(senderName)
        if not HealthDrainEnabled or senderName == LocalPlayer.Name then return end
        local otherPlayer = Players:FindFirstChild(senderName)
        if not otherPlayer or not otherPlayer.Character or not LocalPlayer.Character then return end
        
        local root1 = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local root2 = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
        local hum1 = LocalPlayer.Character:FindFirstChild("Humanoid")
        
        if root1 and root2 and hum1 then
            local dist = (root1.Position - root2.Position).Magnitude
            if dist < 60 then
                local dot = root1.CFrame.LookVector:Dot(root2.CFrame.LookVector)
                -- If dot is close to -1, they are perfectly facing each other
                if dot < -0.9 then
                    hum1:TakeDamage(2.5) -- Drain health if opponent hits arrow
                end
            end
        end
    end

    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            TextChatService.MessageReceived:Connect(function(msg)
                if string.match(msg.Text, "%[FNF_ARROW_HIT%]") then
                    local sender = msg.TextSource and msg.TextSource.Name or ""
                    ProcessHealthDrain(sender)
                end
            end)
        else
            ReplicatedStorage.DefaultChatSystemChatEvents.OnMessageDoneFiltering.OnClientEvent:Connect(function(msgData)
                if string.match(msgData.Message, "%[FNF_ARROW_HIT%]") then
                    ProcessHealthDrain(msgData.FromSpeaker)
                end
            end)
        end
    end)
    
    -- INTENSE MODE RENDER LOOP
