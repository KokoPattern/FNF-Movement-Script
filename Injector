local function swapFace(dir: string)
    if not faceDecal then return end
    local id = faceIds[dir]
    if id and id ~= "" then
        faceDecal.Texture = "rbxassetid://"..id
    end
end

local function restoreFace()
    if faceDecal and defaultFaceId then
        faceDecal.Texture = defaultFaceId
    end
end

local function applyLegsLock(locked: boolean)
    if not character then return end
    local hum: Humanoid? = character:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if locked then
        savedWalkSpeed = hum.WalkSpeed
        savedJumpPower = hum.JumpPower
        hum.WalkSpeed = 0
        hum.JumpPower = 0
    else
        hum.WalkSpeed = savedWalkSpeed
        hum.JumpPower = savedJumpPower
    end
end

local function pushRecent(id: string, label: string?)
    if not id or id == "" then return end
    for i = #recents, 1, -1 do
        if recents[i].id == id then table.remove(recents, i) end
    end
    table.insert(recents, 1, { id = id, label = label or id })
    while #recents > RECENTS_CAP do table.remove(recents) end
end

local function updatePreviewAnimation(assetId: string, label: string?)
    StatusState.currentAnimName = label or assetId
    StatusState.currentAnimId = assetId
    if not previewAnimator or not assetId or assetId == "" then return end
    local ok, result = pcall(function()
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://"..assetId
        local t = previewAnimator:LoadAnimation(anim)
        t.Priority = Enum.AnimationPriority.Action
        return t
    end)
    if ok and result then
        for _, t in ipairs(previewAnimator:GetPlayingAnimationTracks()) do t:Stop(0) end
        result:Play(0.05)
    end
end

-- ============================================================
--  RP TUG-OF-WAR STATE & AUTO-DODGE CONFIG
-- ============================================================
local rpRetreatStep: number = 1.2   
local rpMaxDistance: number = 25.0  
local targetCharAddedConn: RBXScriptConnection? = nil   

local function stopWatchingTargetAnims()
    if targetAnimConn then targetAnimConn:Disconnect(); targetAnimConn = nil end
    if targetCharAddedConn then targetCharAddedConn:Disconnect(); targetCharAddedConn = nil end
end

local function triggerRetreatOrDodge()
    if not rpModeEnabled or not currentTarget then return end
    if not character or not currentTarget.Character then return end

    local myRoot: BasePart? = character:FindFirstChild("HumanoidRootPart") :: BasePart?
    local targetRoot: BasePart? = currentTarget.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
    if not myRoot or not targetRoot then return end

    if rpDodgeEnabled then
        local dodgeDir = (math.random() > 0.5) and 1 or -1
        local dodgeOffset = myRoot.CFrame.RightVector * (3.5 * dodgeDir)
        TweenService:Create(myRoot, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            CFrame = myRoot.CFrame + dodgeOffset
        }):Play()
        notify(dodgeDir == 1 and "Dodged Right!" or "Dodged Left!", "success")
    else
        local awayVector = (myRoot.Position - targetRoot.Position)
        local distance = awayVector.Magnitude
        if distance <= 0.001 then return end 
        if distance < rpMaxDistance then
            local actualStep = math.min(rpRetreatStep, rpMaxDistance - distance)
            myRoot.CFrame = myRoot.CFrame + (awayVector.Unit * actualStep)
        end
    end
end

local function startWatchingTargetAnims()
    stopWatchingTargetAnims()
    if not currentTarget then return end

    local function bindAnimator(targetChar: Model)
        if not targetChar then return end
        local hum = targetChar:WaitForChild("Humanoid", 5)
        if not hum then return end
        local anr: Animator? = hum:WaitForChild("Animator", 5) or hum:FindFirstChildOfClass("Animator")
        if not anr then return end

        targetAnimConn = anr.AnimationPlayed:Connect(function(track)
            if rpModeEnabled then triggerRetreatOrDodge() end
        end)
    end

    if currentTarget.Character then bindAnimator(currentTarget.Character) end

    targetCharAddedConn = currentTarget.CharacterAdded:Connect(function(newChar)
        stopWatchingTargetAnims()
        bindAnimator(newChar)
    end)
end

local function setTargetPlayer(partialName: string?, isDashTarget: boolean): Player?
    if not partialName or partialName == "" then
        if isDashTarget then 
            MOVEMENT_STATE.DashTarget = nil 
        else 
            currentTarget = nil; stopWatchingTargetAnims() 
        end
        return nil
    end

    local lowerName = partialName:lower()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Name:lower():sub(1, #lowerName) == lowerName then
            if isDashTarget then
                MOVEMENT_STATE.DashTarget = player
                if notify then notify("Dash Target locked: " .. player.Name, "success") end
            else
                currentTarget = player
                startWatchingTargetAnims()
                if notify then notify("Target locked: " .. player.Name, "success") end
            end
            return player
        end
    end

    if notify then notify("Player not found.", "warn") end
    return nil
end

local function triggerRPMovement()
    if not rpModeEnabled or not currentTarget then return end
    if not character or not currentTarget.Character then return end

    local myRoot: BasePart? = character:FindFirstChild("HumanoidRootPart") :: BasePart?
    local targetRoot: BasePart? = currentTarget.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
    if not myRoot or not targetRoot then return end

    local direction = (targetRoot.Position - myRoot.Position)
    local distance = direction.Magnitude

    if distance > rpMinDistance then
        local actualStep = math.min(rpMoveStep, distance - rpMinDistance)
        myRoot.CFrame = myRoot.CFrame + (direction.Unit * actualStep)
    end
end
 
-- ============================================================
--  DIRECTIONAL ANIMATION PLAYBACK
-- ============================================================
local function playAnim(key: string, assetId: string, speedMult: number?, holdLoop: boolean)
    if not animator then return end
    speedMult = speedMult or 1
    if (speedMult :: number) <= 0 then speedMult = 0.01 end
    local wantLooped = holdLoop and true or false

    local track = animTracks[key]
    if not track or not track.Animation
        or track.Animation.AnimationId ~= "rbxassetid://"..assetId
        or track.Looped ~= wantLooped then
        destroyTrack(key)
        local ok, result = pcall(function()
            local anim = Instance.new("Animation")
            anim.AnimationId = "rbxassetid://"..assetId
            local t = animator:LoadAnimation(anim)
            t.Priority = PRIORITY; t.Looped = wantLooped
            return t
        end)
        if not ok then warn("[FNF] Load fail: "..assetId); return end
        track = result; animTracks[key] = track
    end

    if wantLooped then
        track:Play(BLEND_IN)
        track:AdjustSpeed(speedMult)
    else
        local baseReach = FRAME_TARGET / 60
        local reach = baseReach / (speedMult :: number)
        track:Play(BLEND_IN)
        track:AdjustSpeed(track.Length > 0 and (track.Length / reach) or 10)
        task.delay(reach, function()
            if track and track.IsPlaying then
                track:AdjustSpeed(0)
                track.TimePosition = math.max(0, track.Length - 0.01)
            end
        end)
    end

    StatusState.currentAnimName = key
    StatusState.currentAnimId   = assetId
    StatusState.speedMult       = speedMult :: number
    StatusState.playing         = true
    updatePreviewAnimation(assetId, key)
    pushRecent(assetId, key)
end

local function stopAnim(key: string)
    local t = animTracks[key]
    if t and t.IsPlaying then t:Stop(BLEND_OUT) end
    StatusState.playing = false
end

local function rollBindingAnimId(row: Binding): string
    if row.alts and #row.alts > 0 then
        local roll = math.random() * 100
        local acc = 0
        for _, alt in ipairs(row.alts) do
            acc = acc + alt.chance
            if roll <= acc and alt.id ~= "" then
                return alt.id
            end
        end
    end
    return row.id
end

