            if step.id and step.id ~= "" then
                destroySeqTrack()
                local ok, result = pcall(function()
                    local anim = Instance.new("Animation")
                    anim.AnimationId = "rbxassetid://"..step.id
                    local t = animator:LoadAnimation(anim)
                    t.Priority = PRIORITY; t.Looped = false
                    return t
                end)
                if ok then
                    seqTrack = result
                    pcall(function() seqTrack:Play(0) end)
                    updatePreviewAnimation(step.id, "SEQUENCE")
                end
            end
            task.wait(math.max(0.01, step.delay or 0.5))
        end
        destroySeqTrack()
        seqPlaying = false
    end)
end

function stopSequence()
    seqPlaying = false
    destroySeqTrack()
end

-- ==============================================================================================
--  PLAYLIST MANAGER
-- ==============================================================================================
function playPlaylist()
    if playlistPlaying or #playlist == 0 or not animator then return end
    playlistPlaying = true
    task.spawn(function()
        while playlistPlaying do
            local step = playlist[playlistIndex]
            if step and step.id and step.id ~= "" then
                destroySeqTrack()
                local ok, result = pcall(function()
                    local anim = Instance.new("Animation")
                    anim.AnimationId = "rbxassetid://"..step.id
                    local t = animator:LoadAnimation(anim)
                    t.Priority = PRIORITY; t.Looped = false
                    return t
                end)
                if ok then
                    seqTrack = result
                    pcall(function() seqTrack:Play(0) end)
                    updatePreviewAnimation(step.id, step.name or ("Playlist #"..playlistIndex))
                end
            end
            task.wait(math.max(0.05, (step and step.delay) or 1))
            if not playlistPlaying then break end
            playlistIndex = playlistIndex + 1
            if playlistIndex > #playlist then playlistIndex = 1 end
        end
        destroySeqTrack()
    end)
end

function stopPlaylist()
    playlistPlaying = false
    destroySeqTrack()
end

function nextPlaylistTrack()
    if #playlist == 0 then return end
    playlistIndex = playlistIndex + 1
    if playlistIndex > #playlist then playlistIndex = 1 end
end

function prevPlaylistTrack()
    if #playlist == 0 then return end
    playlistIndex = playlistIndex - 1
    if playlistIndex < 1 then playlistIndex = #playlist end
end

-- ==============================================================================================
--  DOUBLE TROUBLE SYNC SYSTEM LOGIC (EXPANDED WITH RP PUSHBACK)
-- ==============================================================================================
function stopDoubleTrouble()
    SYNC_STATE.Enabled = false
    if SYNC_STATE.Connection then
        SYNC_STATE.Connection:Disconnect()
        SYNC_STATE.Connection = nil
    end
    SYNC_STATE.TargetPlayer = nil
    forceResetArrows()
    notify("Double Trouble Sync Offline", "error")
end

function startDoubleTrouble(playerName)
    stopDoubleTrouble()
    if playerName == "" then return end
    
    local lowerName = playerName:lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Name:lower():sub(1, #lowerName) == lowerName then
            SYNC_STATE.TargetPlayer = p
            break
        end
    end
    
    if not SYNC_STATE.TargetPlayer then
        notify("Player not found for Sync!", "warn")
        return
    end
    
    local function bindToTargetAnimator(targetChar)
        local hum = targetChar:WaitForChild("Humanoid", 5)
        local targetAnimator = hum and hum:WaitForChild("Animator", 5)
        if not targetAnimator then return end
        
        SYNC_STATE.Enabled = true
        notify("Double Trouble Synced to: " .. SYNC_STATE.TargetPlayer.Name, "success")
        
        SYNC_STATE.Connection = targetAnimator.AnimationPlayed:Connect(function(track)
            if not SYNC_STATE.Enabled then return end
            
            local id = track.Animation.AnimationId:match("%d+")
            if not id then return end
            
            local randomDir = ARROW_ORDER[math.random(1, #ARROW_ORDER)]
            
            task.delay(SYNC_STATE.MimicDelay, function()
                playAnim("SYNC_MIMIC", id, 1, false)
                hitArrow(randomDir)
                if SYNC_STATE.SyncPushback then
                    triggerRetreat() -- Uses RP logic to push them back automatically
                end
                
                -- Safe Unlink Arrow Reset Logic
                task.delay(0.2, function() 
                    if not SYNC_STATE.Enabled then return end
                    if not PressedKeys[randomDir] then
                        releaseArrow(randomDir) 
                    end
                end)
            end)
        end)
    end
    
    if SYNC_STATE.TargetPlayer.Character then
        bindToTargetAnimator(SYNC_STATE.TargetPlayer.Character)
    end
    
    -- Re-bind if they respawn
    SYNC_STATE.TargetPlayer.CharacterAdded:Connect(function(char)
        if SYNC_STATE.Enabled then bindToTargetAnimator(char) end
    end)
end

