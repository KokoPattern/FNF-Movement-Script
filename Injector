    toggleFlight.Parent = frame
    local tc = Instance.new("UICorner"); tc.CornerRadius = UDim.new(0, 6); tc.Parent = toggleFlight

    toggleFlight.MouseButton1Click:Connect(function()
        MovementConfig.Enabled = not MovementConfig.Enabled
        local char = LocalPlayer.Character
        if MovementConfig.Enabled then
            toggleFlight.Text = "FLIGHT: ON"
            toggleFlight.BackgroundColor3 = Color3.fromRGB(0, 255, 127)
            if char then BindCharacter(char) end
        else
            toggleFlight.Text = "FLIGHT: OFF"
            toggleFlight.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid.PlatformStand = false
            end
            if currentBV then currentBV:Destroy(); currentBV = nil end
            if currentBG then currentBG:Destroy(); currentBG = nil end
        end
    end)

    local iconBox = Instance.new("TextBox")
    iconBox.Size = UDim2.new(0.9, 0, 0, 35)
    iconBox.Position = UDim2.new(0.05, 0, 0, 75)
    iconBox.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    iconBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    iconBox.Text = MovementConfig.IconDecalID
    iconBox.PlaceholderText = "Decal ID..."
    iconBox.Font = Enum.Font.Gotham
    iconBox.Parent = frame
    local ic = Instance.new("UICorner"); ic.CornerRadius = UDim.new(0, 6); ic.Parent = iconBox

    local updateIcon = Instance.new("TextButton")
    updateIcon.Size = UDim2.new(0.9, 0, 0, 25)
    updateIcon.Position = UDim2.new(0.05, 0, 0, 115)
    updateIcon.BackgroundColor3 = Color3.fromRGB(70, 120, 255)
    updateIcon.Text = "SET ICON ID"
    updateIcon.TextColor3 = Color3.fromRGB(255, 255, 255)
    updateIcon.Font = Enum.Font.GothamBold
    updateIcon.Parent = frame
    local uc = Instance.new("UICorner"); uc.CornerRadius = UDim.new(0, 6); uc.Parent = updateIcon

    updateIcon.MouseButton1Click:Connect(function()
        local id = iconBox.Text:gsub("%D", "")
        if id ~= "" then
            MovementConfig.IconDecalID = id
            for _, player in ipairs(Players:GetPlayers()) do
                if player.Character and player.Character:FindFirstChild("Head") then
                    local bg = player.Character.Head:FindFirstChild("FNF_MOVEMENT_TAG")
                    if bg and bg:FindFirstChildOfClass("ImageLabel") then
                        bg.ImageLabel.Image = "rbxassetid://" .. id
                    end
                end
            end
        end
    end)
