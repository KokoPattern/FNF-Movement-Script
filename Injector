function setupMicSpectrogram()
    micAvailable = false
    local ok = pcall(function()
        if not micDeviceInput then
            micDeviceInput = Instance.new("AudioDeviceInput")
            micDeviceInput.Player = LocalPlayer; micDeviceInput.Parent = LocalPlayer
        end
        if not micAnalyzer then
            micAnalyzer = Instance.new("AudioAnalyzer")
            micAnalyzer.WindowSize = 1024; micAnalyzer.Parent = LocalPlayer
        end
        if not micWire then
            micWire = Instance.new("Wire")
            micWire.SourceInstance = micDeviceInput; micWire.TargetInstance = micAnalyzer; micWire.Parent = micAnalyzer
        end
        micDeviceInput.Active = true
    end)
    micAvailable = ok and micDeviceInput ~= nil and micAnalyzer ~= nil
    if not micAvailable then log("Mic spectrogram unavailable") end
    return micAvailable
end

-- ==============================================================================================
--  ADVANCED BEAT / VISUALIZER LOOPS
-- ==============================================================================================
local eqBars, waveBars, beatDot, notesLayer, particleLayer = nil, nil, nil, nil, nil

function startVisualizerLoops()
    task.spawn(function()
        local lastTime = os.clock()
        while true do
            RunService.RenderStepped:Wait()
            local currentTime = os.clock()
            currentFPS = math.floor(1 / (currentTime - lastTime) + 0.5)
            lastTime = currentTime
        end
    end)

    task.spawn(function()
        while true do
            task.wait(FX_SETTINGS.VisualizerTickRate)
            if not FX_SETTINGS.EnableEqualizer then continue end
            local speed = StatusState.playing and 0.08 or 0.22
            if eqBars then
                for _, bar in ipairs(eqBars) do
                    local h = StatusState.playing and (0.25 + math.random() * 0.75) or (0.08 + math.random() * 0.2)
                    TweenService:Create(bar, TweenInfo.new(speed, Enum.EasingStyle.Sine), { Size = UDim2.new(1, 0, h, 0) }):Play()
                end
            end
        end
    end)

    task.spawn(function()
        local t = 0
        while true do
            RunService.Heartbeat:Wait()
            if not FX_SETTINGS.EnableWaveform then continue end
            t = t + (StatusState.bpm / 60) * 0.03
            if waveBars then
                for i, bar in ipairs(waveBars) do
                    local h = 0.15 + 0.35 * (0.5 + 0.5 * math.sin(t + i * 0.6))
                    bar.Size = UDim2.new(1, 0, h, 0)
                end
            end
        end
    end)

    task.spawn(function()
        while true do
            local interval = 60 / math.max(1, StatusState.bpm)
            task.wait(interval)
            if not FX_SETTINGS.EnableBeatPulse then continue end
            if beatDot then
                beatDot.Size = UDim2.new(0, 22, 0, 22)
                TweenService:Create(beatDot, TweenInfo.new(interval * 0.85, Enum.EasingStyle.Quad), { Size = UDim2.new(0, 10, 0, 10) }):Play()
            end
        end
    end)

    task.spawn(function()
        local symbols = { "♪", "♫", "♬", "♩", "♮", "♭", "♯" }
        while true do
            task.wait(0.6 + math.random() * 0.7)
            if not FX_SETTINGS.EnableFloatingNotes then continue end
            if notesLayer then
                local n = Instance.new("TextLabel")
                n.Size = UDim2.new(0, 20, 0, 20)
                n.Position = UDim2.new(math.random(), 0, 1, 0)
                n.BackgroundTransparency = 1
                n.Text = symbols[math.random(1, #symbols)]
                n.TextColor3 = THEMES[currentThemeName].accent
                n.TextTransparency = 0.2
                n.Font = Enum.Font.GothamBold
                n.TextSize = 14 + math.random(0, 12)
                n.Parent = notesLayer
                regText(n)
                local duration = 3 + math.random()*2
                local tw = TweenService:Create(n, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Position = UDim2.new(n.Position.X.Scale, 0, -0.15, 0), TextTransparency = 1 })
                tw:Play()
                tw.Completed:Connect(function() n:Destroy() end)
            end
        end
    end)

    task.spawn(function()
        while true do
            task.wait(FX_SETTINGS.ParticleSpawnRate + (math.random() * 0.4))
            if not FX_SETTINGS.EnableAmbientParticles then continue end
            if particleLayer then
                local p = Instance.new("Frame")
                local sz = math.random(2, 5)
                p.Size = UDim2.new(0, sz, 0, sz)
                p.Position = UDim2.new(math.random(), 0, 1, 0)
                p.BackgroundColor3 = THEMES[currentThemeName].accent2
                p.BackgroundTransparency = 0.3
                p.BorderSizePixel = 0
                p.Parent = particleLayer
                uiCorner(p, UDim.new(1,0))
                local tw = TweenService:Create(p, TweenInfo.new(FX_SETTINGS.ParticleLifetime, Enum.EasingStyle.Sine), { Position = UDim2.new(p.Position.X.Scale + (math.random()-0.5)*0.15, 0, -0.05, 0), BackgroundTransparency = 1 })
                tw:Play()
                tw.Completed:Connect(function() p:Destroy() end)
            end
        end
    end)

    task.spawn(function()
        while true do
            RunService.Heartbeat:Wait()
            if not FX_SETTINGS.EnableVinylSpin then continue end
            if vinylImage then
                local rpm
                if StatusState.playing and StatusState.speedMult then rpm = vinylBaseRPM * StatusState.speedMult else rpm = vinylBaseRPM * idleSpeedFromBPM() end
                vinylRotation = (vinylRotation + (rpm / 60) * 360 * (1/60)) % 360
                vinylImage.Rotation = vinylRotation
            end
        end
    end)

    task.spawn(function()
        while true do
            task.wait(FX_SETTINGS.VisualizerTickRate)
            if not FX_SETTINGS.EnableSpectrogram then continue end
            if #specBars > 0 then
                if micAvailable and micAnalyzer then
                    local ok, spectrum = pcall(function() return micAnalyzer:GetSpectrum() end)
                    if ok and spectrum then
                        local n = #spectrum
                        for i, bar in ipairs(specBars) do
                            local idx = math.max(1, math.floor((i / #specBars) * n))
                            local mag = spectrum[idx] or 0
                            local h = math.clamp(mag * 2, 0.05, 1)
                            TweenService:Create(bar, TweenInfo.new(0.05), { Size = UDim2.new(1,0,h,0) }):Play()
                        end
                    else micAvailable = false end
                else
                    for i, bar in ipairs(specBars) do
                        local base = StatusState.playing and 0.3 or 0.08
                        local h = base + math.random() * (StatusState.playing and 0.6 or 0.15)
                        TweenService:Create(bar, TweenInfo.new(0.05), { Size = UDim2.new(1,0,h,0) }):Play()
                    end
                end
            end
        end
    end)

    task.spawn(function()
        while true do
            task.wait(0.06 + math.random() * 0.12)
            if FX_SETTINGS.EnableCRTMode and crtOverlay then
                crtOverlay.BackgroundTransparency = 0.82 + math.random() * 0.08
            end
        end
    end)
end

