local function setupMicSpectrogram(): boolean
    micAvailable = false
    local ok = pcall(function()
        micDeviceInput = Instance.new("AudioDeviceInput")
        (micDeviceInput :: AudioDeviceInput).Player = LocalPlayer
        (micDeviceInput :: AudioDeviceInput).Parent = workspace

        micAnalyzer = Instance.new("AudioAnalyzer")
        (micAnalyzer :: AudioAnalyzer).WindowSize = 1024
        (micAnalyzer :: AudioAnalyzer).Parent = micDeviceInput

        micWire = Instance.new("Wire")
        (micWire :: Wire).SourceInstance = micDeviceInput
        (micWire :: Wire).TargetInstance = micAnalyzer
        (micWire :: Wire).Parent = micAnalyzer

        (micDeviceInput :: AudioDeviceInput).Active = true
    end)
    micAvailable = ok and micDeviceInput ~= nil and micAnalyzer ~= nil
    if not micAvailable then
        log("Mic spectrogram unavailable on this client/game — using animation-synced fallback")
    end
    return micAvailable
end

