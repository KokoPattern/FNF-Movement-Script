end

function LoadData()
    if isfile and readfile and isfile(SAVE_FILE_NAME) then
        pcall(function()
            local decoded = HttpService:JSONDecode(readfile(SAVE_FILE_NAME))
            if decoded then
                DataStoreConfig.CustomBackgroundId = decoded.Background or ""
