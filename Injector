function QTESuccess()
    if not character then return end
    local myRoot = character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    QTE_STATE.OriginalCFrame = myRoot.CFrame
    QTE_STATE.DodgeCounter = QTE_STATE.DodgeCounter + 1
    local dodgeDistance = 8
    local dodgePos

    if QTE_STATE.DodgeCounter % 3 == 0 then
        local dirMultiplier = (math.random() > 0.5) and 1 or -1
        dodgePos = myRoot.CFrame * CFrame.new(dirMultiplier * dodgeDistance, 0, 0)
    else
        dodgePos = myRoot.CFrame * CFrame.new(0, 0, dodgeDistance)
    end
    
    local tw = TweenService:Create(myRoot, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {CFrame = dodgePos})
    tw:Play()
    notify("QTE DODGE SUCCESS!", "success")

    task.delay(0.4, function()
        if character and myRoot and QTE_STATE.OriginalCFrame then
            local twBack = TweenService:Create(myRoot, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {CFrame = QTE_STATE.OriginalCFrame})
            twBack:Play()
        end
    end)
end

