    if QTE_STATE.DodgeCounter % 3 == 0 then
        local dirMultiplier = (math.random() > 0.5) and 1 or -1
        dodgePos = myRoot.CFrame * CFrame.new(dirMultiplier * dodgeDistance, 0, 0)
    else
        dodgePos = myRoot.CFrame * CFrame.new(0, 0, dodgeDistance)
    end
    
    local tw = TweenService:Create(myRoot, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {CFrame = dodgePos})
