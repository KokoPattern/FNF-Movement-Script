local function Init()
    log("Starting FNF Injector Omega v9.2...")
    
    -- Setup Cleanup Hook
    shared._FNF_INJECTOR_CLEANUP = function()
        cleanupAll()
        stopDoubleTrouble()
        toggleMovement(false)
        if UI_CONTAINER:FindFirstChild("FNFInjectorGui") then UI_CONTAINER.FNFInjectorGui:Destroy() end
        if UI_CONTAINER:FindFirstChild("FNFHealthBar") then UI_CONTAINER.FNFHealthBar:Destroy() end
        if UI_CONTAINER:FindFirstChild("FNFArrowHud") then UI_CONTAINER.FNFArrowHud:Destroy() end
        if globalCinematicUI then globalCinematicUI:Destroy() end
        if hitTextContainer then hitTextContainer:Destroy() end
    end

    buildGUI()
    buildArrowHud()
    setupMicSpectrogram()
    startVisualizerLoops()
    
    -- Announce Presence
    task.delay(2, function()
        local role = IS_OWNER and "OWNER" or "DEFAULT"
        broadcastNetworkMessage("PING", DataStoreConfig.CustomNametagName .. "~" .. role)
    end)
    
    notify("Loaded Ultimate Omega V9.2! Have fun.", "success")
end

Init()
