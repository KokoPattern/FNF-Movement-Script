        b.Size = size; b.Position = pos; b.BackgroundColor3 = bg
        b.Text = text; b.TextColor3 = tc or Color3.fromRGB(255,255,255)
        b.Font = Enum.Font.GothamBold; b.TextSize = ts or 12
        b.BorderSizePixel = 0; b.Parent = parent; b.AutoButtonColor = false
