local function spawnAuraParticle(rootPart: BasePart?)
    if not FX_SETTINGS.EnableAuraSystem or not rootPart then return end
    
    local part: Part = Instance.new("Part")
    part.Size = Vector3.new(1, 1, 1)
    part.CFrame = rootPart.CFrame * CFrame.new(math.random(-2,2), math.random(-3,1), math.random(-2,2))
    part.Anchored = true
    part.CanCollide = false
    part.Massless = true
    part.Material = Enum.Material.Neon
    part.Color = AURA_STATE.Color
    part.Transparency = 0.3
    part.Parent = workspace

    TweenService:Create(part, TweenInfo.new(AURA_STATE.FixedDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        CFrame = part.CFrame * CFrame.new(0, 5, 0) * CFrame.Angles(math.rad(math.random(-180, 180)), math.rad(math.random(-180, 180)), 0),
        Transparency = 1,
        Size = Vector3.new(0, 0, 0)
    }):Play()

    task.delay(AURA_STATE.FixedDuration, function()
        if part then part:Destroy() end
    end)
end

