function broadcastNetworkMessage(action, dataString)
    local payload = string.format("%s %s|%s", NETWORK_PREFIX, action, dataString)
    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
            if channel then channel:SendAsync(payload) end
        else
            ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer(payload, "All")
        end
    end)
end

function hideChatMessages()
    -- Attempt to hide our handshake messages from the chat UI
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        TextChatService.OnIncomingMessage = function(message)
            if message.Text:match("^" .. NETWORK_PREFIX:gsub("%[", "%%["):gsub("%]", "%%]")) then
                local properties = Instance.new("TextChatMessageProperties")
                properties.IsVisible = false
                return properties
            end
            return nil
        end
    end
end
pcall(hideChatMessages)

