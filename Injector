function refreshCustomDecals()
    for dir, frameData in pairs(arrowHudFrames) do
        local config = CUSTOM_DECALS[dir]
        if config.useDecal and config.id ~= "" then
            local finalId = config.id
            if config.isLink then
                finalId = getCustomAssetFromURL(config.id)
            else
                finalId = "rbxassetid://" .. config.id:gsub("%D", "")
            end
            
            frameData.img.Image = finalId
            frameData.img.Visible = true; frameData.lbl.Visible = false; frameData.bg.BackgroundTransparency = 1 
        else
            frameData.img.Visible = false; frameData.lbl.Visible = true; frameData.bg.BackgroundTransparency = 0
        end
    end
