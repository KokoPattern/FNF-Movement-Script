            track.Looped = looped or false; track:Play(); track:AdjustSpeed(speed or 1)
            return track
        else
            local animation = Instance.new("Animation"); animation.AnimationId = idString
            local success, track = pcall(function() return animator:LoadAnimation(animation) end)
            if success and track then
                LoadedAnimations[idString] = track
                track.Looped = looped or false; track:Play(); track:AdjustSpeed(speed or 1)
