function stopWatchingTargetAnims()
    if targetAnimConn then targetAnimConn:Disconnect(); targetAnimConn = nil end
    if targetCharAddedConn then targetCharAddedConn:Disconnect(); targetCharAddedConn = nil end
end

function triggerRetreat()
    if not rpModeEnabled or not currentTarget then return end
    if not character or not currentTarget.Character then return end

    local myRoot = character:FindFirstChild("HumanoidRootPart")
    local targetRoot = currentTarget.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot or not targetRoot then return end

    local awayVector = (myRoot.Position - targetRoot.Position)
    local distance = awayVector.Magnitude

    if distance <= 0.001 then return end 

    if distance < rpMaxDistance then
        local actualStep = math.min(rpRetreatStep, rpMaxDistance - distance)
        myRoot.CFrame = myRoot.CFrame + (awayVector.Unit * actualStep)
    end
end

function startWatchingTargetAnims()
    stopWatchingTargetAnims()
    if not currentTarget then return end

    local function bindAnimator(targetChar)
        if not targetChar then return end
        local hum = targetChar:WaitForChild("Humanoid", 5)
        if not hum then return end
        local anr = hum:WaitForChild("Animator", 5) or hum:FindFirstChildOfClass("Animator")
        if not anr then return end

        targetAnimConn = anr.AnimationPlayed:Connect(function(track)
            if rpModeEnabled then triggerRetreat() end
            if BAR_STATE.Enabled then
                updateFNFBarHealth(BAR_STATE.Health - 5)
            end
        end)
    end

    if currentTarget.Character then bindAnimator(currentTarget.Character) end

    targetCharAddedConn = currentTarget.CharacterAdded:Connect(function(newChar)
        stopWatchingTargetAnims()
        bindAnimator(newChar)
    end)
end

function setTargetPlayer(partialName, isClientSkip)
    if not partialName or partialName == "" then
        currentTarget = nil
        RP_STATE.Host = false
        RP_STATE.Client = false
        RP_STATE.Connected = false
        RP_STATE.Partner = nil
        stopWatchingTargetAnims()
        notify("RP Target cleared.", "info")
        if BAR_STATE.UI then BAR_STATE.UI.Screen.Enabled = false end
        return nil
    end

    local lowerName = partialName:lower()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Name:lower():sub(1, #lowerName) == lowerName then
            currentTarget = player
            startWatchingTargetAnims()
            
            if not isClientSkip then
                RP_STATE.Host = true
                RP_STATE.Client = false
                RP_STATE.Connected = true
                RP_STATE.Partner = player
                broadcastNetworkMessage("RP_LINK", player.Name)
                notify("Target locked: " .. player.Name .. " (You are Host)", "success")
            end
            
            buildFNFBarUI() 
            return player
        end
    end

    notify("Player not found.", "warn")
    return nil
end

function triggerRPMovement()
    if not rpModeEnabled or not currentTarget then return end
    if not character or not currentTarget.Character then return end

    local myRoot = character:FindFirstChild("HumanoidRootPart")
    local targetRoot = currentTarget.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot or not targetRoot then return end

    local direction = (targetRoot.Position - myRoot.Position)
    local distance = direction.Magnitude

    if distance > rpMinDistance then
        local actualStep = math.min(rpMoveStep, distance - rpMinDistance)
        if direction.Magnitude > 0 then
            myRoot.CFrame = myRoot.CFrame + (direction.Unit * actualStep)
        end
    end
end
 
function triggerDashHit()
    if not MOVEMENT_STATE.DashOnHit or not currentTarget or not currentTarget.Character then return end
    if MOVEMENT_STATE.IsCurrentlyDashing then return end

    local myRoot = character:FindFirstChild("HumanoidRootPart")
    local targetRoot = currentTarget.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot or not targetRoot then return end
    
    MOVEMENT_STATE.IsCurrentlyDashing = true
    
    local oldCFrame = myRoot.CFrame
    
    local targetPos = targetRoot.Position
    local myPos = myRoot.Position
    local diff = Vector3.new(targetPos.X, myPos.Y, targetPos.Z) - myPos
    if diff.Magnitude <= 0.001 then 
        MOVEMENT_STATE.IsCurrentlyDashing = false
        return 
    end
    
    local direction = diff.Unit
    local dashDest = Vector3.new(targetPos.X, myPos.Y, targetPos.Z) - (direction * 4)
    
    local dashCFrame = CFrame.lookAt(dashDest, Vector3.new(targetPos.X, myPos.Y, targetPos.Z))
    
    local dashIn = TweenService:Create(myRoot, TweenInfo.new(0.08, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {CFrame = dashCFrame})
    dashIn:Play()
    broadcastNetworkMessage("QTE_ATTACK", currentTarget.Name)

    dashIn.Completed:Connect(function()
        local dashOut = TweenService:Create(myRoot, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {CFrame = oldCFrame})
        dashOut:Play()
        dashOut.Completed:Connect(function()
            MOVEMENT_STATE.IsCurrentlyDashing = false
        end)
    end)
end

