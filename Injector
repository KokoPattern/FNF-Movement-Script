function cleanupMovement()
    if MOVEMENT_STATE.BodyVelocity then MOVEMENT_STATE.BodyVelocity:Destroy(); MOVEMENT_STATE.BodyVelocity = nil end
    if MOVEMENT_STATE.BodyGyro then MOVEMENT_STATE.BodyGyro:Destroy(); MOVEMENT_STATE.BodyGyro = nil end
    if character and character:FindFirstChildOfClass("Humanoid") then
        character:FindFirstChildOfClass("Humanoid").PlatformStand = false
    end
end

function toggleMovement(state)
    MOVEMENT_STATE.Enabled = state
    if not state then
        cleanupMovement()
        notify("Movement Engine Offline", "error")
        return
    end
    
    if not character then return end
    local root = character:FindFirstChild("HumanoidRootPart")
    local hum = character:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    
    cleanupMovement()
    hum.PlatformStand = true 
    
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(100000, 100000, 100000)
    bv.Velocity = Vector3.new(0,0,0)
    bv.Parent = root
    MOVEMENT_STATE.BodyVelocity = bv
    
    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(100000, 100000, 100000)
    bg.P = 15000
    bg.CFrame = root.CFrame
    bg.Parent = root
    MOVEMENT_STATE.BodyGyro = bg
    
    notify(MOVEMENT_STATE.Style .. " Movement Active!", "success")
end

RunService.RenderStepped:Connect(function(deltaTime)
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local root = character.HumanoidRootPart
    
    if MOVEMENT_STATE.Spinning then
        MOVEMENT_STATE.CurrentSpinAngle = (MOVEMENT_STATE.CurrentSpinAngle + (MOVEMENT_STATE.SpinSpeed * deltaTime * 60)) % 360
        if not MOVEMENT_STATE.Enabled then
            root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, math.rad(MOVEMENT_STATE.CurrentSpinAngle), 0)
        end
    end
    
    if not MOVEMENT_STATE.Enabled or not MOVEMENT_STATE.BodyVelocity or not MOVEMENT_STATE.BodyGyro then return end
    
    MOVEMENT_STATE.HoverTime = MOVEMENT_STATE.HoverTime + deltaTime
    
    local moveVector = Vector3.new()
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveVector = moveVector + Camera.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveVector = moveVector - Camera.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveVector = moveVector - Camera.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveVector = moveVector + Camera.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveVector = moveVector + Vector3.new(0,1,0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveVector = moveVector - Vector3.new(0,1,0) end
    
    local targetVelocity = Vector3.new()
    local yOffset = 0
    
    if MOVEMENT_STATE.Style == "Fleetway" then
        yOffset = math.noise(MOVEMENT_STATE.HoverTime * 10, 0, 0) * 2
        targetVelocity = (moveVector * MOVEMENT_STATE.FlightSpeed) + Vector3.new(
            math.noise(MOVEMENT_STATE.HoverTime * 15, 1, 0),
            yOffset,
            math.noise(MOVEMENT_STATE.HoverTime * 15, 2, 0)
        ) * 5
    elseif MOVEMENT_STATE.Style == "GodEater" then
        yOffset = math.sin(MOVEMENT_STATE.HoverTime * 3) * MOVEMENT_STATE.HoverHeight
        targetVelocity = (moveVector * MOVEMENT_STATE.FlightSpeed) + Vector3.new(0, yOffset, 0)
    end
    
    MOVEMENT_STATE.BodyVelocity.Velocity = targetVelocity
    
    if MOVEMENT_STATE.Spinning then
        MOVEMENT_STATE.BodyGyro.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, math.rad(MOVEMENT_STATE.CurrentSpinAngle), 0)
    elseif MOVEMENT_STATE.Shiftlock then
        MOVEMENT_STATE.BodyGyro.CFrame = CFrame.new(root.Position, root.Position + Camera.CFrame.LookVector)
    else
        if moveVector.Magnitude > 0.1 then
            MOVEMENT_STATE.BodyGyro.CFrame = CFrame.new(root.Position, root.Position + targetVelocity.Unit)
        else
            local currentLook = root.CFrame.LookVector
            MOVEMENT_STATE.BodyGyro.CFrame = CFrame.new(root.Position, root.Position + Vector3.new(currentLook.X, 0, currentLook.Z))
        end
    end
end)


-- ==============================================================================================
--  INPUT HANDLER
-- ==============================================================================================
local lastNoteTime = 0
local DOUBLE_NOTE_WINDOW = 0.08 

function onInput(input, _gp)
    if rebindingRow then
        local kn = input.KeyCode and input.KeyCode.Name or "Unknown"
        if input.UserInputState == Enum.UserInputState.Begin
            and kn ~= "Unknown" and not kn:match("Mouse") then
            rebindingRow.key = kn
            rebindingRow.keyBtn.Text = kn
            rebindingRow.keyBtn.BackgroundColor3 = Color3.fromRGB(30, 20, 45)
            rebindingRow = nil
        end
        return
    end
    
    for _, row in ipairs(CurrentBindings) do
        if input.KeyCode and input.KeyCode.Name == row.key then
            if input.UserInputState == Enum.UserInputState.Begin then
                PressedKeys[row.dir] = true
                local now = os.clock()
                local isDouble = (now - lastNoteTime) <= DOUBLE_NOTE_WINDOW
                lastNoteTime = now

                -- 1 Toggle logic (Ghost tap restrict)
                if FX_SETTINGS.OneToggleEnabled then
                    for k, track in pairs(animTracks) do
                        if track.IsPlaying and k ~= "SYNC_MIMIC" then
                            pcall(function() track:Stop(0) end) 
                        end
                    end
                else
                    for k, track in pairs(animTracks) do
                        if track.IsPlaying and k ~= "SYNC_MIMIC" then
                            pcall(function() track:Stop(0) end) 
                        end
                    end
                end
                
                if isDouble then
                    spawnAfterimage(character)
                end

                local chosenId = rollBindingAnimId(row)
                playAnim(row.key, chosenId, row.speedMult, row.holdLoop)
                
                hitArrow(row.dir)
                swapFace(row.dir)
                triggerRPMovement()
                triggerDashHit()
                registerBpmTap()
                
            elseif input.UserInputState == Enum.UserInputState.End then
                PressedKeys[row.dir] = false
                if not FX_SETTINGS.OneToggleEnabled then
                    stopAnim(row.key)
                end
                releaseArrow(row.dir)
                restoreFace()
            end
        end
    end
end

