function onNetworkMessage(message)
    local msgText = message.Text or message.Message
    local sourceUser = message.TextSource and message.TextSource.UserId or message.SenderId
    if not sourceUser or sourceUser == LocalPlayer.UserId then return end 

    if blacklistedUsers[sourceUser] then return end -- Ignore blacklisted users

    if msgText and msgText:match("^" .. NETWORK_PREFIX:gsub("%[", "%%["):gsub("%]", "%%]")) then
        local content = msgText:sub(#NETWORK_PREFIX + 2)
        local separator = content:find("|")
        if not separator then return end
        
        local action = content:sub(1, separator - 1)
        local data = content:sub(separator + 1)
        
        local peerPlayer = Players:GetPlayerByUserId(sourceUser)
        if not peerPlayer then return end

        if action == "PING" then
            local datParts = data:split("~")
            local peerCustomName = datParts[1]
            local peerRole = datParts[2] or "DEFAULT"
            scriptPeers[sourceUser] = { name = peerCustomName, role = peerRole }
            rebuildNametag(peerPlayer, peerCustomName, peerRole)
            forceDialogueListRefresh()

        elseif action == "CHAT" then
            local chatSeparator = data:find("~")
            local animId = ""
            local msg = data
            if chatSeparator then
                animId = data:sub(1, chatSeparator - 1)
                msg = data:sub(chatSeparator + 1)
            end
            if not scriptPeers[sourceUser] then
                scriptPeers[sourceUser] = { name = peerPlayer.DisplayName, role = "DEFAULT" }
                forceDialogueListRefresh()
            end
            buildDialogueUI(peerPlayer.Character, peerPlayer.DisplayName, msg, animId)
            
        elseif action == "RP_LINK" then
            if data == LocalPlayer.Name and not RP_STATE.Host then
                RP_STATE.Client = true
                RP_STATE.Connected = true
                RP_STATE.Partner = peerPlayer
                setTargetPlayer(peerPlayer.Name, true) -- true skips broadcast loop
                notify("RP Connection Linked by " .. peerPlayer.Name .. ". They are the Host.", "info")
            end
            
        elseif action == "BAR_SYNC" then
            if RP_STATE.Client and RP_STATE.Partner == peerPlayer then
                local parts = data:split("~")
                BAR_STATE.OppIcon = parts[1]
                BAR_STATE.MyIcon = parts[2]
                BAR_STATE.Side = parts[3]
                if BAR_STATE.UI then buildFNFBarUI() end
            end
            
        elseif action == "SYNC_MISC" then
            if RP_STATE.Client and RP_STATE.Partner == peerPlayer then
                local parts = data:split("~")
                DataStoreConfig.MiscCinematic = (parts[1] == "true")
                DataStoreConfig.MiscFlash = (parts[2] == "true")
                notify("Host updated Sync settings.", "info")
            end

        elseif action == "QTE_ATTACK" then
            if data == LocalPlayer.Name and QTE_STATE.Enabled then
                triggerQTEEvent(peerPlayer)
                broadcastNetworkMessage("QTE_SLOW", peerPlayer.Name)
            end
            
        elseif action == "QTE_SLOW" then
            if data == LocalPlayer.Name then applyCinematicSlowmo(true) end
            
        elseif action == "QTE_END" then
            if data == LocalPlayer.Name then applyCinematicSlowmo(false) end
            
        elseif action == "HEALTH_DRAIN" then
            if BAR_STATE.Enabled and data == LocalPlayer.Name then
                updateFNFBarHealth(BAR_STATE.Health - 5)
            end
            
        elseif action == "ANNOUNCE" then
            notify("[GLOBAL]: " .. data, "warn")
            
        elseif action == "BLACKLIST" then
            local parts = data:split("~")
            local targetId = tonumber(parts[1])
            if targetId == LocalPlayer.UserId and not IS_OWNER then
                cleanupAll()
                if UI_CONTAINER:FindFirstChild("FNFInjectorGui") then UI_CONTAINER.FNFInjectorGui:Destroy() end
                if UI_CONTAINER:FindFirstChild("FNFHealthBar") then UI_CONTAINER.FNFHealthBar:Destroy() end
                if UI_CONTAINER:FindFirstChild("FNFArrowHud") then UI_CONTAINER.FNFArrowHud:Destroy() end
            end
        
        elseif action == "UNBLACKLIST" then
            local targetId = tonumber(data)
            if targetId == LocalPlayer.UserId and not IS_OWNER then
                notify("You have been unblacklisted by an owner. Reload the script.", "success")
            end
        end
    end
end

