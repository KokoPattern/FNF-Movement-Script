function applyMiddlescrollLayout()
    local totalW = #ARROW_ORDER * ARROW_SIZE + (#ARROW_ORDER - 1) * ARROW_GAP
    local bottomY = FX_SETTINGS.MiddlescrollEnabled and (Camera.ViewportSize.Y / 2 - ARROW_SIZE/2) or 50  

    for i, dir in ipairs(ARROW_ORDER) do
        local f = arrowHudFrames[dir]
        if f then
            local cx = -totalW/2 + (i-1)*(ARROW_SIZE + ARROW_GAP) + ARROW_SIZE/2
            local targetPos = UDim2.new(0.5, cx, 1, -bottomY)
            if FX_SETTINGS.MiddlescrollEnabled then
                f.bg.BackgroundTransparency = CUSTOM_DECALS[dir].useDecal and 1 or 0.4
            else
                f.bg.BackgroundTransparency = CUSTOM_DECALS[dir].useDecal and 1 or 0
            end
            TweenService:Create(f.bg, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Position = targetPos}):Play()
        end
    end
end

